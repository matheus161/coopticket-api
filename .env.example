# ==================================================================
# Configuração local de desenvolvimento — CoopTicket
# Copie este arquivo para .env e ajuste os valores se necessário
# ==================================================================

# Banco de dados (deve bater com docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coopticket
DB_USER=coopticket
DB_PASSWORD=coopticket_dev_password

# Aplicação
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
